# Copy to `.env` beside this file. It is read at the root of this checkout only, by `uv run adk-review`,
# `uv run python -m adk_review.review`, the login and `adk web`, and a variable already set in the shell wins over
# it, everywhere. An installed command (`uv tool install`) reads the shell alone.

# LiteLLM fetches its model map from the network at every import unless told
# not to; this keeps it to the map the pinned version ships.
LITELLM_LOCAL_MODEL_COST_MAP=True

# ---- The arm: copilot, the one this reviewer targets first and the arm when blank, or gemini, first-class too. ----
REVIEW_PROVIDER=copilot
# Model within that provider. Blank = the provider's default (gpt-4.1 / gemini-2.5-flash). GitHub has deprecated
# gpt-4.1 in Copilot: it answers while Copilot serves it, under per-user rate limits GitHub does not publish. Name a
# model the seat's plan serves that can judge at temperature 0; `--dry-run` says whether LiteLLM lets it.
# Google serves gemini-2.5-flash only to those who have used it before. Its Gemini 3 models may loop below
# temperature 1.0, Google says, and a review runs at 0: try one on the demo before you rely on it.
REVIEW_MODEL=

# ---- Copilot: no key. ----
# Run `uv run adk-review-login` once (`adk-review-login` once installed): GitHub's device flow prints a code to enter in
# a browser, then caches a token under ~/.config/litellm/github_copilot, or GITHUB_COPILOT_TOKEN_DIR, and LiteLLM reads
# it. Calls are billed to the seat that logged in, as its plan bills Copilot chat. Copilot Free and Student pick the
# model themselves, so a named one needs another plan, and a model the plan or the organisation's Copilot policy leaves
# off answers model_not_supported. Copilot's GPT models after gpt-4.1, gpt-6-luna among them, reason by default, and the
# o-series always: neither can judge at temperature 0, at which every review runs, and each is refused before any call.
# GITHUB_COPILOT_TOKEN_DIR=~/.config/litellm/github_copilot

# ---- Gemini: REVIEW_PROVIDER=gemini above, and one of the two ways in below. ----
# An AI Studio key:
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=
# Or through Vertex AI (GOOGLE_GENAI_USE_ENTERPRISE=TRUE): a project, signed in once with
# `gcloud auth application-default login`, and a region, blank for global. A key there is express mode's alone. The
# project may be left out where the credentials name one: gcloud's own project, a service account's, Cloud Run's.
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=global

# ---- Either arm ----
# The second opinion's own model (`--verify`). Blank = REVIEW_MODEL.
REVIEW_VERIFIER_MODEL=
# One guideline's own model, by its id. Blank = the guideline file's `models` for the arm, else REVIEW_MODEL.
# REVIEW_SECURITY_MODEL=

# A second model behind every role's first, tried on a 429, a 5xx or a timeout (ADK's FallbackModel), on either arm:
# Gemini's free tier counts its quota per model, and Copilot's rate limits differ by model. Blank = none.
REVIEW_FALLBACK_MODEL=

# GitHub Enterprise Cloud with data residency, a *.ghe.com tenant: its own endpoints, read by LiteLLM and by the
# login. Leave them unset for github.com.
# GITHUB_COPILOT_API_BASE=https://copilot-api.my-company.ghe.com
# GITHUB_COPILOT_DEVICE_CODE_URL=https://my-company.ghe.com/login/device/code
# GITHUB_COPILOT_ACCESS_TOKEN_URL=https://my-company.ghe.com/login/oauth/access_token
# GITHUB_COPILOT_API_KEY_URL=https://api.my-company.ghe.com/copilot_internal/v2/token
